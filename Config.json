{
  "meta": {
    "version": 1,
    "schema": "fa-scrap/v1",
    "description": "Fa-Scrap unified configuration. Identity (agents+profiles), Policy (cookies+legal), Discovery, Health, Storage, and learned site overrides.",
    "notes": {
      "agents": "74 real user-agent strings, each paired with its curl_cffi impersonate target and a header profile.",
      "profiles": "Header bundles parameterized by ${version}, ${platform}. Resolved at load time per agent.",
      "sites": "50 hand-curated high-value domains. 'learned' grows automatically.",
      "learned": "Written by the engine. Never edit by hand. Structure: {domain: {agent, profile, rate, first_seen, ok, fail}}."
    }
  },
  "runtime": {
    "concurrency": {
      "mode": "auto",
      "initial": 128,
      "min": 16,
      "max": 1024,
      "probe_window": 200,
      "scale_up_threshold": 0.95,
      "scale_down_threshold": 0.75,
      "interval_seconds": 3.0
    },
    "timeout_seconds": 15,
    "connect_timeout_seconds": 5,
    "read_timeout_seconds": 15,
    "max_attempts": 3,
    "queue_maxsize": 8192,
    "flush_interval_seconds": 5.0,
    "metrics_interval_seconds": 1.0,
    "memory_trim_interval_seconds": 30.0,
    "gc_collect_every_n_pages": 10000,
    "platform": {
      "nice": 19,
      "scheduler": "SCHED_IDLE",
      "mallopt_arena_max": 2,
      "gc_freeze": true,
      "malloc_trim_on_flush": true
    }
  },
  "discovery": {
    "max_depth_default": 3,
    "max_depth_by_authority": {
      "news": 5,
      "reference": 6,
      "ecommerce": 4,
      "social": 2,
      "search": 1,
      "blog": 4,
      "default": 3
    },
    "allow_external_default": false,
    "skip_schemes": [
      "javascript",
      "mailto",
      "tel",
      "data",
      "ftp",
      "blob",
      "file"
    ],
    "skip_extensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".svg",
      ".ico",
      ".bmp",
      ".mp4",
      ".mp3",
      ".avi",
      ".mov",
      ".wmv",
      ".flv",
      ".mkv",
      ".webm",
      ".pdf",
      ".zip",
      ".rar",
      ".7z",
      ".tar",
      ".gz",
      ".bz2",
      ".xz",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".odt",
      ".exe",
      ".dll",
      ".so",
      ".dmg",
      ".iso",
      ".apk",
      ".deb",
      ".rpm",
      ".css",
      ".js",
      ".woff",
      ".woff2",
      ".ttf",
      ".eot",
      ".map"
    ],
    "follow_query_strings": false,
    "strip_fragments": true,
    "normalize_lowercase_host": true,
    "normalize_strip_default_port": true
  },
  "health": {
    "sweep_interval_seconds": 60,
    "batch_size": 50,
    "retry_after_block_seconds": 300,
    "retry_after_unreachable_seconds": 600,
    "retry_after_soft_block_seconds": 900,
    "dead_after_failures": 25,
    "dead_after_hours": 72,
    "reset_on_success": true,
    "health_check_path_default": "/",
    "probe_agents_order": [
      "chrome146_win",
      "safari27_mac",
      "firefox147_win",
      "chrome131_android"
    ]
  },
  "storage": {
    "base_dir": ".",
    "data_dir": "data",
    "resume_dir": "resume",
    "resume_jsonl": "resume.jsonl",
    "resume_zst": "resume.jsonl.zst",
    "resume_zip": "resume.zip",
    "max_lines_per_file": 900,
    "zstd_level": 22,
    "zip_compression": "deflate",
    "domain_partition_by_date": true,
    "write_direct_io": true
  },
  "cookies": {
    "default_policy": {
      "necessary": "accept",
      "functional": "reject",
      "analytics": "reject",
      "performance": "reject",
      "marketing": "reject",
      "advertising": "reject",
      "social_media": "reject",
      "personalization": "reject",
      "targeting": "reject",
      "profiling": "reject",
      "unknown": "reject"
    },
    "consent_selectors": {
      "banner": [
        ".cookie-banner",
        "#cookie-consent",
        "[id*='cookie']",
        "[class*='cookie']",
        "[aria-label*='cookie']"
      ],
      "accept": [
        "button[aria-label*='Accept']",
        "button[aria-label*='Allow']",
        ".cookie-accept",
        "#accept-cookies",
        "[data-action='accept']"
      ],
      "reject": [
        "button[aria-label*='Reject']",
        "button[aria-label*='Decline']",
        ".cookie-reject",
        "#reject-cookies",
        "[data-action='reject']"
      ],
      "close": [
        "[aria-label='Close']",
        ".close",
        ".dismiss"
      ]
    },
    "auto_dismiss": true,
    "persist_per_domain": true
  },
  "legal": {
    "accept_terms_of_service": true,
    "accept_privacy_policy": true,
    "accept_cookie_policy": true,
    "accept_age_verification": true,
    "accept_adult_content": true,
    "accept_region_restrictions": true,
    "accept_paywall_soft": false,
    "accept_newsletter_popup": false,
    "respect_robots_txt": false
  },
  "block_patterns": [
    "cf-browser-verification",
    "cloudflare",
    "captcha",
    "access denied",
    "access-denied",
    "blocked",
    "forbidden",
    "rate limit",
    "rate-limit",
    "too many requests",
    "datadome",
    "perimeterx",
    "akamai",
    "kasada",
    "incapsula",
    "are you a robot",
    "verify you are human",
    "checking your browser",
    "just a moment",
    "enable javascript and cookies to continue",
    "ddos protection",
    "bot detection",
    "unusual traffic"
  ],
